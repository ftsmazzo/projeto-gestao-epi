# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (EasyPanel ou local) - nunca commitar segredos reais
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Auth JWT - use um segredo forte em producao
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS: URL(s) do front separadas por virgula. Use * apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:3000

# URL publica do Web (links de autoenrollment facial). Se omitido, usa o primeiro CORS_ORIGIN.
# PUBLIC_WEB_URL=http://localhost:3000

# Evidencias faciais de entrega (storage local privado da API).
# OBRIGATORIO em producao: volume persistente. Sem isso, redeploy APAGA as fotos.
# Exemplo EasyPanel: DELIVERY_EVIDENCE_DIR=/app/files/delivery-evidence
# DELIVERY_EVIDENCE_DIR=

# Referencias faciais dos trabalhadores (template + foto).
# OBRIGATORIO em producao: volume persistente no mesmo path entre deploys.
# Exemplo: WORKER_FACE_REFERENCE_DIR=/app/files/worker-face-references
# WORKER_FACE_REFERENCE_DIR=

# Limiar de matching facial (distancia euclidiana maxima; menor = mais rigoroso).
# Padrao: 0.55 (face-api tipicamente usa ~0.6).
# FACE_MATCH_THRESHOLD=0.55

# Retencao / exclusao biometrica (09.3). Desabilitada por padrao.
# BIOMETRIC_RETENTION_ENABLED=true
# Cron padrao: 02:00 todos os dias
# BIOMETRIC_RETENTION_CRON=0 2 * * *

# CAEPI
# CAEPI_SOURCE_URL e OPCIONAL: apenas override tecnico.
# Em operacao normal o sistema usa fontes oficiais padrao (gov.br + FTP MTPS).
# Nao e necessario configurar URL para o cliente atualizar a base.
# CAEPI_SOURCE_URL=
CAEPI_AUTO_SYNC_ENABLED=false
# Cron padrao: 03:00 no dia 1 de cada mes
CAEPI_SYNC_CRON=0 3 1 * *

# Comunicacoes (fase 2). Desabilitado por padrao — nao quebra fluxos atuais.
# COMMUNICATIONS_ENABLED=true
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Gestao EPI
# EVOLUTION_API_URL=https://sua-evolution.exemplo.com
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# Alertas diarios (EPI/CA/biometria). Padrao: 11:00 UTC (~08:00 BRT).
# COMMUNICATIONS_ALERTS_ENABLED=true
# COMMUNICATIONS_ALERTS_CRON=0 11 * * *
