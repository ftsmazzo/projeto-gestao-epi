generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/// Papel operacional do usuario na empresa cliente (CNPJ). Distinto do Membership do tenant.
enum ClientUserRole {
  CLIENT_MANAGER
  STOCK_OPERATOR
  /// Reservado para portal do trabalhador (nao usado nesta etapa).
  WORKER
}

/// Estado do acesso do usuario na empresa cliente.
enum ClientUserAccessStatus {
  PREPARED
  INVITED
  ACTIVE
  DISABLED
}

enum ServedClientStatus {
  ACTIVE
  INACTIVE
}

enum OperationalUnitStatus {
  ACTIVE
  INACTIVE
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum EpiUnitOfMeasure {
  UNIDADE
  PAR
  CAIXA
  KIT
}

enum EpiUsefulLifeUnit {
  DIAS
  MESES
  ANOS
}

enum EpiCategory {
  AUDITIVA
  RESPIRATORIA
  QUEDA
  MAOS
  OLHOS
  CABECA
  PES
  TRONCO
  OUTROS
}

/// Empresa usuaria do software (tenant). Nao e cliente atendido nem unidade operacional.
model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  /// Franquia total de vidas contratadas (preparacao para billing/cotas futuras).
  contractedLifeQuota Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships       Membership[]
  clientUserMemberships ClientUserMembership[]
  auditLogs         AuditLog[]
  servedClients     ServedClient[]
  operationalUnits  OperationalUnit[]
  workers           Worker[]
  epiItems          EpiItem[]
  epiVariants       EpiVariant[]
  stockLocations    StockLocation[]
  epiStockBalances  EpiStockBalance[]
  epiStockMovements EpiStockMovement[]
  epiNeeds          EpiNeed[]
  epiItemNeeds      EpiItemNeed[]
  clientSectors     ClientSector[]
  clientJobFunctions ClientJobFunction[]
  occupationalRisks OccupationalRisk[]
  jobFunctionRisks  JobFunctionRisk[]
  jobFunctionEpiRequirements JobFunctionEpiRequirement[]
  pgroImportRuns    PgroImportRun[]
  epiDeliveries     EpiDelivery[]
  epiDeliveryReturns EpiDeliveryReturn[]
  workerFacialReferences WorkerFacialReference[]
  workerBiometricConsents WorkerBiometricConsent[]
  workerFacialEnrollmentLinks WorkerFacialEnrollmentLink[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  clientUserMemberships ClientUserMembership[]
  auditLogs       AuditLog[]
  caepiImportRuns CaepiImportRun[]
  epiStockMovements EpiStockMovement[]
  pgroImportRuns  PgroImportRun[]
  epiDeliveries   EpiDelivery[]                 @relation("EpiDeliveryDeliveredBy")
  cancelledDeliveries EpiDelivery[]             @relation("EpiDeliveryCancelledBy")
  epiDeliveryReturns EpiDeliveryReturn[]        @relation("EpiDeliveryReturnBy")
  workerFacialReferences WorkerFacialReference[] @relation("WorkerFacialReferenceCreatedBy")
  facialReferencesDeleted WorkerFacialReference[] @relation("WorkerFacialReferenceDeletedBy")
  biometricConsentsCreated WorkerBiometricConsent[] @relation("WorkerBiometricConsentCreatedBy")
  biometricConsentsUpdated WorkerBiometricConsent[] @relation("WorkerBiometricConsentUpdatedBy")
  deliveryEvidencesDeleted DeliveryEvidence[] @relation("DeliveryEvidenceDeletedBy")
  facialEnrollmentLinksCreated WorkerFacialEnrollmentLink[] @relation("WorkerFacialEnrollmentLinkCreatedBy")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Cliente atendido pelo tenant. Distinto de Organization e de OperationalUnit.
model ServedClient {
  id                 String             @id @default(cuid())
  organizationId     String
  legalName          String
  tradeName          String?
  /// CNPJ apenas digitos (14).
  cnpj               String
  status             ServedClientStatus @default(ACTIVE)
  allocatedLifeQuota Int                @default(0)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operationalUnits OperationalUnit[]
  workers          Worker[]
  sectors          ClientSector[]
  jobFunctions     ClientJobFunction[]
  pgroImportRuns   PgroImportRun[]
  clientUsers      ClientUserMembership[]
  stockLocations   StockLocation[]
  epiDeliveries    EpiDelivery[]
  epiDeliveryReturns EpiDeliveryReturn[]
  workerFacialReferences WorkerFacialReference[]
  workerBiometricConsents WorkerBiometricConsent[]
  workerFacialEnrollmentLinks WorkerFacialEnrollmentLink[]

  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([status])
}

/// Usuario operacional da empresa cliente (gestor / estoque). Nao consome vidas.
model ClientUserMembership {
  id                          String                 @id @default(cuid())
  organizationId              String
  servedClientId              String
  /// Null enquanto o login ainda nao foi provisionado.
  userId                      String?
  email                       String
  name                        String
  phone                       String?
  role                        ClientUserRole
  isActive                    Boolean                @default(true)
  accessStatus                ClientUserAccessStatus @default(PREPARED)
  mustChangePassword          Boolean                @default(false)
  temporaryPasswordCreatedAt  DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient ServedClient @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([servedClientId, email])
  @@index([organizationId])
  @@index([servedClientId])
  @@index([userId])
  @@index([role, isActive])
  @@index([accessStatus])
}

/// Unidade operacional do cliente atendido (filial, obra, planta, local de entrega).
model OperationalUnit {
  id             String                @id @default(cuid())
  organizationId String
  servedClientId String
  name           String
  code           String?
  /// CNPJ opcional da filial/unidade (normalizado, sem mascara). Pode coincidir com o CNPJ do cliente.
  cnpj           String?
  status         OperationalUnitStatus @default(ACTIVE)
  addressLine    String?
  city           String?
  state          String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient ServedClient @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  workers      Worker[]
  sectors      ClientSector[]

  @@unique([servedClientId, code])
  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([servedClientId])
  @@index([status])
}

enum OccupationalRiskCategory {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  MECANICO
  ACIDENTE
  PSICOSSOCIAL
  OUTROS
}

enum RiskLevel {
  MUITO_BAIXO
  BAIXO
  MODERADO
  ALTO
  MUITO_ALTO
}

/// Setor organizacional do cliente atendido (opcionalmente ligado a uma unidade).
model ClientSector {
  id                 String   @id @default(cuid())
  organizationId     String
  servedClientId     String
  operationalUnitId  String?
  name               String
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient    ServedClient     @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  operationalUnit OperationalUnit? @relation(fields: [operationalUnitId], references: [id], onDelete: SetNull)
  jobFunctions    ClientJobFunction[]
  workers         Worker[]

  @@index([organizationId])
  @@index([servedClientId])
  @@index([operationalUnitId])
  @@index([isActive])
}

/// Funcao/cargo do cliente, vinculada a um setor.
model ClientJobFunction {
  id                     String   @id @default(cuid())
  organizationId         String
  servedClientId         String
  sectorId               String
  name                   String
  description            String?
  environmentDescription String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient ServedClient      @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  sector       ClientSector      @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  risks        JobFunctionRisk[]
  epiRequirements JobFunctionEpiRequirement[]
  workers      Worker[]

  @@index([organizationId])
  @@index([servedClientId])
  @@index([sectorId])
  @@index([isActive])
}

/// Catalogo de riscos ocupacionais do tenant (reutilizavel entre clientes).
model OccupationalRisk {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  category       OccupationalRiskCategory
  description    String?
  aliases        Json?
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobLinks     JobFunctionRisk[]
  epiRequirements JobFunctionEpiRequirement[]

  @@index([organizationId])
  @@index([category])
  @@index([isActive])
}

enum EpiRequirementSource {
  MANUAL
  PGRO
  IMPORT
}

/// Necessidade de EPI exigida por uma funcao/cargo (opcionalmente por risco).
model JobFunctionEpiRequirement {
  id                      String               @id @default(cuid())
  organizationId          String
  jobFunctionId           String
  riskId                  String?
  epiNeedId               String
  isRequired              Boolean              @default(true)
  quantity                Int                  @default(1)
  replacementIntervalDays Int?
  notes                   String?
  source                  EpiRequirementSource @default(MANUAL)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobFunction  ClientJobFunction @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)
  risk         OccupationalRisk? @relation(fields: [riskId], references: [id], onDelete: SetNull)
  epiNeed      EpiNeed           @relation(fields: [epiNeedId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([jobFunctionId])
  @@index([riskId])
  @@index([epiNeedId])
  @@index([isActive])
}

/// Vinculo entre funcao do cliente e risco ocupacional.
model JobFunctionRisk {
  id               String     @id @default(cuid())
  organizationId   String
  jobFunctionId    String
  riskId           String
  exposure         String?
  source           String?
  possibleDamage   String?
  riskLevel        RiskLevel?
  notes            String?
  createdAt        DateTime   @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobFunction  ClientJobFunction @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)
  risk         OccupationalRisk @relation(fields: [riskId], references: [id], onDelete: Restrict)

  @@unique([organizationId, jobFunctionId, riskId])
  @@index([organizationId])
  @@index([jobFunctionId])
  @@index([riskId])
}

/// Trabalhador (vida) vinculado a um cliente atendido e opcionalmente a uma unidade.
model Worker {
  id                 String       @id @default(cuid())
  organizationId     String
  servedClientId     String
  operationalUnitId  String?
  /// Setor da estrutura do cliente (ClientSector).
  clientSectorId     String?
  /// Funcao/cargo da estrutura (ClientJobFunction) — fonte dos EPIs herdados.
  clientJobFunctionId String?
  name               String
  /// CPF apenas digitos (11), opcional.
  cpf                String?
  /// Matricula/codigo interno, unico por cliente quando informado.
  registration       String?
  email              String?
  phone              String?
  /// Texto legado/espelho do nome da funcao (compat).
  role               String?
  /// Texto legado/espelho do nome do setor (compat).
  department         String?
  status             WorkerStatus @default(ACTIVE)
  admissionDate      DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient     ServedClient      @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  operationalUnit  OperationalUnit? @relation(fields: [operationalUnitId], references: [id], onDelete: SetNull)
  clientSector     ClientSector?     @relation(fields: [clientSectorId], references: [id], onDelete: SetNull)
  clientJobFunction ClientJobFunction? @relation(fields: [clientJobFunctionId], references: [id], onDelete: SetNull)
  deliveries        EpiDelivery[]
  facialReferences  WorkerFacialReference[]
  biometricConsents WorkerBiometricConsent[]
  facialEnrollmentLinks WorkerFacialEnrollmentLink[]

  @@unique([organizationId, cpf])
  @@unique([servedClientId, registration])
  @@index([organizationId])
  @@index([servedClientId])
  @@index([operationalUnitId])
  @@index([clientSectorId])
  @@index([clientJobFunctionId])
  @@index([status])
}

/// Item do catalogo mestre de EPI do tenant (ainda sem estoque/entrega).
model EpiItem {
  id               String             @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  isActive         Boolean            @default(true)
  requiresCa       Boolean            @default(true)
  /// Numero do CA normalizado (sem espacos). Unico por tenant quando informado.
  caNumber         String?
  caExpiresAt      DateTime?
  unitOfMeasure    EpiUnitOfMeasure   @default(UNIDADE)
  usefulLifeValue  Int?
  usefulLifeUnit   EpiUsefulLifeUnit?
  category         EpiCategory?
  externalCode     String?
  manufacturerName String?
  reference        String?
  color            String?
  approvedFor      String?
  restriction      String?
  technicalNotes   String?
  /// NRR (protecao auditiva), opcional.
  nrr              Float?
  /// NRRsf (protecao auditiva), opcional.
  nrrsf            Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     EpiVariant[]
  stockBalances EpiStockBalance[]
  stockMovements EpiStockMovement[]
  itemNeeds    EpiItemNeed[]
  deliveryItems EpiDeliveryItem[]

  @@unique([organizationId, caNumber])
  @@index([organizationId])
  @@index([isActive])
  @@index([category])
  @@index([externalCode])
}

/// Variacao/grade de um item do catalogo (tamanho, cor, modelo, lado).
model EpiVariant {
  id             String   @id @default(cuid())
  organizationId String
  epiItemId      String
  size           String?
  color          String?
  model          String?
  side           String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  epiItem      EpiItem      @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  stockBalances EpiStockBalance[]
  stockMovements EpiStockMovement[]
  deliveryItems EpiDeliveryItem[]

  @@index([organizationId])
  @@index([epiItemId])
  @@index([isActive])
}

/// Necessidade operacional de EPI (ex.: Protetor Auricular Plug), distinta do item real com CA.
model EpiNeed {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  category       EpiCategory?
  description    String?
  /// Aliases de busca (JSON array de strings).
  aliases        Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemLinks    EpiItemNeed[]
  jobRequirements JobFunctionEpiRequirement[]
  deliveryItems EpiDeliveryItem[]

  @@index([organizationId])
  @@index([isActive])
  @@index([category])
}

/// Vinculo entre EPI real (EpiItem) e necessidade operacional (EpiNeed).
model EpiItemNeed {
  id             String   @id @default(cuid())
  organizationId String
  epiItemId      String
  epiNeedId      String
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  epiItem      EpiItem      @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  epiNeed      EpiNeed      @relation(fields: [epiNeedId], references: [id], onDelete: Restrict)

  @@unique([organizationId, epiItemId, epiNeedId])
  @@index([organizationId])
  @@index([epiItemId])
  @@index([epiNeedId])
}

enum EpiStockMovementType {
  ENTRADA
  SAIDA_MANUAL
  AJUSTE
  ENTREGA
  DEVOLUCAO
  CANCELAMENTO_ENTREGA
}

/// Local fisico/logico de armazenamento de EPI.
/// servedClientId null = almoxarifado da Consultoria (legado/tenant);
/// preenchido = estoque operacional da empresa cliente (Painel).
model StockLocation {
  id             String   @id @default(cuid())
  organizationId String
  servedClientId String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient ServedClient?      @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  balances     EpiStockBalance[]
  movements    EpiStockMovement[]
  deliveryItems EpiDeliveryItem[]

  @@index([organizationId])
  @@index([servedClientId])
  @@index([isActive])
}

/// Saldo atual de um EPI (e variacao opcional) em um local.
model EpiStockBalance {
  id              String   @id @default(cuid())
  organizationId  String
  epiItemId       String
  epiVariantId    String?
  stockLocationId String
  quantity        Int      @default(0)
  minQuantity     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  epiItem       EpiItem       @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  epiVariant    EpiVariant?   @relation(fields: [epiVariantId], references: [id], onDelete: Cascade)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([epiItemId])
  @@index([epiVariantId])
  @@index([stockLocationId])
}

/// Movimentacao manual de estoque (entrada, saida manual ou ajuste).
model EpiStockMovement {
  id               String               @id @default(cuid())
  organizationId   String
  epiItemId        String
  epiVariantId     String?
  stockLocationId  String
  type             EpiStockMovementType
  /// ENTRADA/SAIDA_MANUAL: quantidade movimentada. AJUSTE: quantidade final desejada.
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  notes            String?
  createdByUserId  String
  createdAt        DateTime             @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  epiItem       EpiItem       @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  epiVariant    EpiVariant?   @relation(fields: [epiVariantId], references: [id], onDelete: SetNull)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  createdByUser User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveryItems EpiDeliveryItem[]
  deliveryReturnItems EpiDeliveryReturnItem[]

  @@index([organizationId])
  @@index([epiItemId])
  @@index([stockLocationId])
  @@index([type])
  @@index([createdAt])
}

enum CaCertificateStatus {
  VALIDO
  VENCIDO
  CANCELADO
  SUSPENSO
  DESCONHECIDO
}

enum CaCertificateSource {
  CAEPI_OFICIAL
}

enum CaepiImportRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum CaepiImportTriggeredBy {
  MANUAL
  SCHEDULED
  UPLOAD
}

/// Certificado de Aprovacao da base oficial CAEPI (global, nao por tenant).
model CaCertificate {
  id                   String              @id @default(cuid())
  /// Numero do CA normalizado, sem espacos. Unico globalmente.
  caNumber             String              @unique
  expiresAt            DateTime?
  status               CaCertificateStatus @default(DESCONHECIDO)
  processNumber        String?
  manufacturerCnpj     String?
  manufacturerName     String?
  nature               String?
  equipmentName        String?
  equipmentDescription String?
  brand                String?
  reference            String?
  color                String?
  approvedFor          String?
  restriction          String?
  analysisNotes        String?
  source               CaCertificateSource @default(CAEPI_OFICIAL)
  sourceImportedAt     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  norms CaCertificateNorm[]

  @@index([status])
  @@index([manufacturerCnpj])
  @@index([expiresAt])
  @@index([equipmentName])
  @@index([manufacturerName])
  @@index([reference])
}

/// Norma/laudo associado a um CA (um CA pode ter varias linhas na base CAEPI).
model CaCertificateNorm {
  id              String   @id @default(cuid())
  certificateId   String
  laboratoryCnpj  String?
  laboratoryName  String?
  reportNumber    String?
  standard        String?
  createdAt       DateTime @default(now())

  certificate CaCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, laboratoryCnpj, reportNumber, standard])
  @@index([certificateId])
  @@index([standard])
}

/// Historico de execucoes de importacao/sincronizacao da base CAEPI.
model CaepiImportRun {
  id                     String                  @id @default(cuid())
  status                 CaepiImportRunStatus    @default(PENDING)
  triggeredBy            CaepiImportTriggeredBy
  sourceUrl              String?
  fileName               String?
  startedAt              DateTime?
  finishedAt             DateTime?
  rowsRead               Int?
  certificatesCreated    Int?
  certificatesUpdated    Int?
  normsCreated           Int?
  rowsSkipped            Int?
  certificatesTotalAfter Int?
  normsTotalAfter        Int?
  errorMessage           String?
  createdByUserId        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([triggeredBy])
  @@index([createdAt])
  @@index([startedAt])
}

enum PgroImportStatus {
  PENDING
  PARSED
  CONFIRMED
  FAILED
}

/// Execucao de importacao assistida de PGRO/PGR (preview + confirmacao humana).
model PgroImportRun {
  id                 String           @id @default(cuid())
  organizationId     String
  servedClientId     String?
  status             PgroImportStatus @default(PENDING)
  fileName           String
  startedAt          DateTime         @default(now())
  finishedAt         DateTime?
  companyData        Json?
  extractedSectors   Json?
  extractedFunctions Json?
  extractedRisks     Json?
  extractedEpiNeeds  Json?
  warnings           Json?
  confirmSummary     Json?
  errorMessage       String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient ServedClient? @relation(fields: [servedClientId], references: [id], onDelete: SetNull)
  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servedClientId])
  @@index([status])
  @@index([createdAt])
}

enum EpiDeliveryStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}

enum EpiDeliveryItemStatus {
  DELIVERED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum DeliveryEvidenceType {
  FACIAL_CAPTURE
}

enum DeliveryEvidenceVerificationStatus {
  CAPTURED
  HUMAN_CONFIRMED
  MATCHED
  REJECTED
  NO_FACE_DETECTED
  MULTIPLE_FACES_DETECTED
  NOT_VERIFIED
}

enum WorkerFacialReferenceStatus {
  ACTIVE
  REVOKED
  /// Referencia antiga so com foto, sem template biometrico — exige recadastro.
  NEEDS_REENROLLMENT
}

enum WorkerBiometricConsentStatus {
  GRANTED
  REVOKED
}

enum WorkerBiometricDeletionStatus {
  NONE
  PENDING
  DELETED
  FAILED
}

/// Link temporario (24h) para o trabalhador cadastrar biometria facial no celular.
/// Token em claro so e devolvido na geracao; no banco fica apenas o hash.
model WorkerFacialEnrollmentLink {
  id              String    @id @default(cuid())
  organizationId  String
  servedClientId  String
  workerId        String
  /// SHA-256 hex do token opaco da URL.
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  failedAttempts  Int       @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient  ServedClient @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  worker        Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("WorkerFacialEnrollmentLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servedClientId])
  @@index([workerId])
  @@index([expiresAt])
  @@index([consumedAt])
}

/// Consentimento LGPD biométrico do trabalhador (Consultoria).
/// Exigido para cadastrar template facial e para entregas com matching.
model WorkerBiometricConsent {
  id               String                        @id @default(cuid())
  organizationId   String
  servedClientId   String
  workerId         String
  status           WorkerBiometricConsentStatus  @default(GRANTED)
  consentText      String
  consentVersion   String
  grantedAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdByUserId  String?
  updatedByUserId  String?
  /// Base para politica de retencao futura (sem job de exclusao nesta etapa).
  retentionUntil   DateTime?
  deletedAt        DateTime?
  deletionStatus   WorkerBiometricDeletionStatus @default(NONE)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient  ServedClient  @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("WorkerBiometricConsentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?         @relation("WorkerBiometricConsentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servedClientId])
  @@index([workerId])
  @@index([status])
  @@index([grantedAt])
  @@index([retentionUntil])
  @@index([deletionStatus])
}

/// Foto + template biometrico do trabalhador (Consultoria).
/// Matching automatico na entrega via descritor 128-d (face-api); nao e liveness.
/// Templates sao dados sensiveis — nunca expor na API; exclusao fisica via 09.3.
model WorkerFacialReference {
  id                 String                       @id @default(cuid())
  organizationId     String
  servedClientId     String
  workerId           String
  /// Caminho relativo privado no storage (nao URL publica). Null apos exclusao.
  filePath           String?
  fileHash           String?
  mimeType           String?
  byteSize           Int?
  /// Descritor facial 128-d (JSON number[]). Sensivel — nunca expor na API.
  faceDescriptor     Json?
  faceEngine         String?
  faceEngineVersion  String?
  qualityScore       Float?
  status             WorkerFacialReferenceStatus  @default(ACTIVE)
  uploadedAt         DateTime                     @default(now())
  createdByUserId    String?
  consentText        String?
  consentAcceptedAt  DateTime?
  revokedAt          DateTime?
  /// Base para retencao/exclusao de arquivos/templates.
  retentionUntil     DateTime?
  deletedAt          DateTime?
  deletionStatus     WorkerBiometricDeletionStatus @default(NONE)
  /// Mensagem segura (sem path) quando deletionStatus=FAILED.
  deletionError      String?
  deletedByUserId    String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient  ServedClient  @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("WorkerFacialReferenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUser User?         @relation("WorkerFacialReferenceDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servedClientId])
  @@index([workerId])
  @@index([status])
  @@index([uploadedAt])
  @@index([retentionUntil])
  @@index([deletionStatus])
}

enum EpiDeliveryReturnCondition {
  REUSABLE
  DAMAGED
  DISCARDED
  LOST
}

/// Entrega de EPI ao trabalhador (Painel do Cliente).
model EpiDelivery {
  id                         String            @id @default(cuid())
  organizationId             String
  servedClientId             String
  workerId                   String
  deliveredByUserId          String
  /// Codigo amigavel do comprovante (unico por cliente atendido).
  receiptNumber              String
  status                     EpiDeliveryStatus @default(COMPLETED)
  deliveredAt                DateTime          @default(now())
  notes                      String?
  /// Texto do aviso/consentimento operacional aceito no ato (LGPD minima).
  evidenceConsentText        String?
  evidenceConsentVersion     String?
  evidenceConsentAcceptedAt  DateTime?
  /// Snapshot do consentimento biometrico LGPD vigente no ato da entrega.
  biometricConsentStatus     WorkerBiometricConsentStatus?
  biometricConsentVersion    String?
  biometricConsentGrantedAt  DateTime?
  operatorIp                 String?
  userAgent                  String?
  cancelledAt                DateTime?
  cancelledByUserId          String?
  cancelReason               String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient    ServedClient         @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  worker          Worker               @relation(fields: [workerId], references: [id], onDelete: Restrict)
  deliveredByUser User                 @relation("EpiDeliveryDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: Restrict)
  cancelledByUser User?                @relation("EpiDeliveryCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items           EpiDeliveryItem[]
  evidences       DeliveryEvidence[]
  returns         EpiDeliveryReturn[]

  @@unique([servedClientId, receiptNumber])
  @@index([organizationId])
  @@index([servedClientId])
  @@index([workerId])
  @@index([deliveredByUserId])
  @@index([cancelledByUserId])
  @@index([deliveredAt])
  @@index([status])
  @@index([receiptNumber])
}

model EpiDeliveryItem {
  id                 String                @id @default(cuid())
  deliveryId         String
  epiNeedId          String
  epiItemId          String
  epiVariantId       String?
  stockLocationId    String
  stockMovementId    String
  quantity           Int
  /// Quantidade ja devolvida (soma das devolucoes).
  returnedQuantity   Int                   @default(0)
  /// Quantidade revertida por cancelamento da entrega.
  cancelledQuantity  Int                   @default(0)
  status             EpiDeliveryItemStatus @default(DELIVERED)
  nextReplacementAt  DateTime?
  /// Snapshot da vida util aplicada na entrega (catalogo ou override).
  usefulLifeValue    Int?
  usefulLifeUnit     EpiUsefulLifeUnit?
  /// Dias de uso por semana (1-7). Null = uso diario (7). Incide no calendário da troca.
  usageDaysPerWeek   Int?
  createdAt          DateTime              @default(now())

  delivery      EpiDelivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  epiNeed       EpiNeed         @relation(fields: [epiNeedId], references: [id], onDelete: Restrict)
  epiItem       EpiItem         @relation(fields: [epiItemId], references: [id], onDelete: Restrict)
  epiVariant    EpiVariant?     @relation(fields: [epiVariantId], references: [id], onDelete: SetNull)
  stockLocation StockLocation   @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  stockMovement EpiStockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  returnItems   EpiDeliveryReturnItem[]

  @@index([deliveryId])
  @@index([epiNeedId])
  @@index([epiItemId])
  @@index([stockLocationId])
  @@index([stockMovementId])
  @@index([status])
}

/// Devolucao de itens de uma entrega (parcial ou total).
model EpiDeliveryReturn {
  id                String   @id @default(cuid())
  organizationId    String
  servedClientId    String
  deliveryId        String
  returnedByUserId  String
  returnedAt        DateTime @default(now())
  reason            String
  notes             String?
  createdAt         DateTime @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  servedClient   ServedClient          @relation(fields: [servedClientId], references: [id], onDelete: Cascade)
  delivery       EpiDelivery           @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  returnedByUser User                  @relation("EpiDeliveryReturnBy", fields: [returnedByUserId], references: [id], onDelete: Restrict)
  items          EpiDeliveryReturnItem[]

  @@index([organizationId])
  @@index([servedClientId])
  @@index([deliveryId])
  @@index([returnedByUserId])
  @@index([returnedAt])
}

model EpiDeliveryReturnItem {
  id              String                     @id @default(cuid())
  returnId        String
  deliveryItemId  String
  quantity        Int
  condition       EpiDeliveryReturnCondition
  /// Preenchido apenas quando a condicao devolve ao estoque (REUSABLE).
  stockMovementId String?
  createdAt       DateTime                   @default(now())

  returnEvent   EpiDeliveryReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  deliveryItem  EpiDeliveryItem    @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)
  stockMovement EpiStockMovement?  @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([deliveryItemId])
  @@index([stockMovementId])
  @@index([condition])
}

/// Evidencia da entrega (captura facial + resultado do matching biometrico).
/// Imagem pode ser removida por retencao LGPD (09.3); metadados do match permanecem.
model DeliveryEvidence {
  id                 String                             @id @default(cuid())
  deliveryId         String
  type               DeliveryEvidenceType               @default(FACIAL_CAPTURE)
  capturedAt         DateTime                           @default(now())
  /// Caminho relativo privado no storage local da API (nao URL publica). Null apos exclusao.
  filePath           String?
  fileHash           String?
  mimeType           String?
  byteSize           Int?
  verificationStatus DeliveryEvidenceVerificationStatus @default(CAPTURED)
  /// Distancia euclidiana entre descritores (menor = mais similar).
  matchDistance      Float?
  matchThreshold     Float?
  faceEngine         String?
  verifiedAt         DateTime?
  metadata           Json?
  retentionUntil     DateTime?
  deletedAt          DateTime?
  deletionStatus     WorkerBiometricDeletionStatus       @default(NONE)
  deletionError      String?
  deletedByUserId    String?
  createdAt          DateTime                           @default(now())

  delivery      EpiDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deletedByUser User?       @relation("DeliveryEvidenceDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([type])
  @@index([capturedAt])
  @@index([verificationStatus])
  @@index([retentionUntil])
  @@index([deletionStatus])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
